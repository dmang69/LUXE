# ──────────────────────────────────────────────
# LUXE COLLECTIVE — Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# Database (PostgreSQL)
DATABASE_URL=******localhost/luxe_collective

# JWT Auth
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google Gemini API (for AI agents)
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# CORS / Trusted Hosts (comma-separated, use * for development only)
ALLOWED_ORIGINS=*
ALLOWED_HOSTS=*

# Dashboard (Streamlit)
API_BASE_URL=http://localhost:8000
DASHBOARD_ADMIN_EMAIL=admin@yourdomain.com
DASHBOARD_ADMIN_PASSWORD=your_admin_password_here

# Luxe Collective – Environment Configuration
# Copy this file to .env and fill in your values before running

# Application
ENV=development
PORT=8000
ENABLE_TASK_WORKER=false

# Database
DATABASE_URL=sqlite:///./luxe_collective.db

# Security
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (comma-separated list of allowed origins; avoid * in production)
CORS_ORIGINS=http://localhost:3000

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=sqlite:///./luxe.db
# For Postgres: DATABASE_URL=******localhost/luxe

# ── JWT Authentication ─────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-32-random-bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── AI Services (leave blank to use mock responses) ───────────
GOOGLE_API_KEY=
OPENAI_API_KEY=

# ── Object Storage (leave blank to store locally in ./assets) ─
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
LOCAL_ASSET_DIR=assets

# ── Backend URL (used by agents & dashboard) ───────────────────
API_BASE_URL=http://localhost:8000

# ── Dashboard ─────────────────────────────────────────────────
DASHBOARD_PASSWORD=luxe-admin

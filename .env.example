# Luxe Collective – Environment Configuration
# Copy this file to .env and fill in your values before running

# Application
ENV=development
PORT=8000

# Database
DATABASE_URL=******localhost:5432/luxe_collective

# Security
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (comma-separated list of allowed origins, use * for development only)
CORS_ORIGINS=*

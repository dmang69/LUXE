# ============================================================
# Luxe Collective – Environment Variables
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# DO NOT COMMIT .env TO VERSION CONTROL
# ============================================================

# PostgreSQL credentials – used by both the db and api services
POSTGRES_USER=luxe
POSTGRES_PASSWORD=change-me-before-use
POSTGRES_DB=luxe_collective

# Database URL – constructed from the values above (no change needed for local dev)
DATABASE_URL=******db:5432/luxe_collective

# Security – generate a strong key:  openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── AI Configuration ──────────────────────────────────────────────────────────

# Set to "true" for immediate demo without an API key (uses mock responses)
# Set to "false" to use real Google Gemini AI generation
USE_MOCK_AI=true

# Required only when USE_MOCK_AI=false
# Get your free key at: https://aistudio.google.com/app/apikey
GENAI_API_KEY=your-google-gemini-api-key-here

# ── CORS / Hosts ──────────────────────────────────────────────────────────────

CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
ALLOWED_HOSTS=localhost,127.0.0.1,api

# ── Optional: S3 Storage (for saving generated assets) ───────────────────────

# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_STORAGE_BUCKET_NAME=luxe-generated-assets
# AWS_DEFAULT_REGION=us-east-1
